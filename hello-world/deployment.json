{
  modulesContent {
    $edgeAgent {
      properties.desired {
        schemaVersion 1.1,
        runtime {
          type docker,
          settings {
            minDockerVersion v1.25,
            loggingOptions 
          }
        },
        systemModules {
          edgeAgent {
            type docker,
            settings {
              image mcr.microsoft.comazureiotedge-agent1.5,
              createOptions {}
            }
          },
          edgeHub {
            type docker,
            status running,
            restartPolicy always,
            settings {
              image mcr.microsoft.comazureiotedge-hub1.5,
              createOptions {}
            }
          }
        },
        modules {
          hello-world {
            version 1.0,
            type docker,
            status running,
            restartPolicy always,
            settings {
              image arm64v8alpinelatest,
              createOptions {Cmd[sh,-c,while true; do echo 'Hello from Azure IoT Edge'; sleep 30; done]}
            }
          }
        }
      }
    },
    $edgeHub {
      properties.desired {
        schemaVersion 1.1,
        routes {
          route FROM messages INTO $upstream
        },
        storeAndForwardConfiguration {
          timeToLiveSecs 7200
        }
      }
    }
  }
}
